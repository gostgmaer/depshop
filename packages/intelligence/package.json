{
  "name": "@dealmind/intelligence",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "dotenv -e ../../.env -- vitest run -c vitest.db.config.ts",
    "seed:sample": "dotenv -e ../../.env -- node dist/sample-data/seed-sample-cli.js",
    "bench:matching": "dotenv -e ../../.env -- node dist/matching/bench/run-bench.js",
    "bench:pricing": "dotenv -e ../../.env -- node dist/pricing/bench/run-bench.js"
  },
  "dependencies": {
    "@dealmind/catalog": "workspace:*",
    "@dealmind/shared": "workspace:*",
    "@dealmind/db": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
