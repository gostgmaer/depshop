// DealMind AI — single-platform, multi-user data model.
//
// There is NO multi-tenancy: no Tenant, Organization or Membership models and
// no tenantId / organizationId / membershipId columns. Data falls into:
//
//   * GLOBAL (shared by every user): Category, Product, ProductVariant,
//     ShoppingSource, ProductOffer, PriceSnapshot, SubscriptionPlan,
//     AffiliateConversion, AiModelConfig, PlatformSetting, AuditLog.
//
//   * USER-OWNED: every model carries a non-null `userId` foreign key to User:
//     UserSession, UserPreference, Search, SearchSourceRun, SearchResult,
//     Watchlist, WatchlistItem, PriceAlert, Notification, NotificationDelivery,
//     AgentRun, Subscription, UsageRecord, BillingEvent.
//     (AffiliateClick.userId is nullable: anonymous visitors can click too.)
//
// OWNERSHIP IS ENFORCED BY THE DATABASE. A child of a user-owned parent
// (e.g. WatchlistItem → Watchlist) references the parent through a composite
// foreign key (parentId, userId) → parent(id, userId), so a row can never be
// attached to another user's parent, even if application code is wrong.
//
// Conventions:
//   * Primary keys: UUIDv7 (time-ordered → compact B-tree indexes), native `uuid`.
//   * Money: integer paise (`Int`; `BigInt` for aggregates). No floats.
//   * Json columns are PostgreSQL `jsonb`.
//   * CHECK constraints that Prisma cannot express live in the migration
//     `*_constraints/migration.sql` and are covered by tests.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════ IDENTITY ═══════════════════════════════

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Local mirror of an identity owned by the shared EasyDev IAM. Credentials,
/// email verification, password reset and 2FA live in the IAM; DealMind keeps
/// this row so its own data can reference users by foreign key, plus the
/// DealMind-specific role and status. Profile fields are synced at sign-in.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// The IAM user id (JWT `sub`). Immutable link to the IAM identity.
  iamUserId       String     @unique @db.Uuid
  /// Always stored lower-case (CHECK constraint), so uniqueness is case-insensitive.
  email           String     @unique
  name            String
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions               UserSession[]
  preference             UserPreference?
  searches               Search[]
  searchSourceRuns       SearchSourceRun[]
  searchResults          SearchResult[]
  watchlists             Watchlist[]
  watchlistItems         WatchlistItem[]
  priceAlerts            PriceAlert[]
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  agentRuns              AgentRun[]
  subscription           Subscription?
  usageRecords           UsageRecord[]
  affiliateClicks        AffiliateClick[]
  billingEvents          BillingEvent[]
  auditLogs              AuditLog[]

  @@index([role])
  @@index([createdAt])
}

/// Server-side browser session. The opaque token lives only in an HttpOnly
/// cookie; the database stores its SHA-256 hash.
model UserSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  /// Rotation family: presenting a rotated-away token revokes the whole family.
  familyId     String    @db.Uuid
  /// Absolute expiry.
  expiresAt    DateTime
  /// Drives the idle timeout; refreshed (throttled) on authenticated requests.
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  /// The IAM session behind this DealMind session (from the IAM access token).
  iamSessionId             String?  @db.Uuid
  /// The user's IAM tokens, AES-256-GCM encrypted with TOKEN_ENCRYPTION_KEY.
  /// They never leave the server: the browser only holds the DealMind cookie.
  iamAccessTokenEnc        String
  iamAccessTokenExpiresAt  DateTime
  iamRefreshTokenEnc       String
  iamRefreshTokenExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([iamSessionId])
}

model UserPreference {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @unique @db.Uuid
  preferredSourceIds String[] @db.Uuid
  preferredBrands    String[]
  notifyEmail        Boolean  @default(true)
  notifyInApp        Boolean  @default(true)
  locale             String   @default("en-IN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════ CATALOG (global) ═══════════════════════════════

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?  @db.Uuid
  /// Inactive categories are hidden from browsing but keep their products.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

/// A canonical product, shared by every user. Identifiers are unique only when
/// present (NULLs never collide). Specifications come only from verified
/// source data and are never generated.
model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  categoryId     String?   @db.Uuid
  /// Display name (canonical).
  name           String
  /// Lower-cased, punctuation-free form of `name`, used for matching.
  normalizedName String
  /// Canonical brand (see @dealmind/catalog normalizeBrand).
  brand          String
  description    String?
  manufacturer   String?
  /// Manufacturer model / part number as published.
  modelNumber    String?
  gtin           String?   @unique
  ean            String?   @unique
  upc            String?   @unique
  specifications Json      @default("{}")
  launchDate     DateTime?
  imageUrl       String?
  isActive       Boolean   @default(true)
  /// Deterministic key: canonical brand + normalized model number (when known).
  fingerprint    String?   @unique
  firstSeenAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  offers   ProductOffer[]
  reviews  ProductMatchReview[]

  @@index([brand])
  @@index([categoryId, isActive])
  @@index([launchDate])
  /// Fuzzy title search (pg_trgm) on the display name and the normalized name.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_normalizedName_trgm_idx")
}

model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  /// Canonical attribute key, e.g. "color=black|ram=8gb|storage=128gb".
  /// Different RAM/storage/capacity/colour never share a key.
  variantKey String
  attributes Json     @default("{}")
  sku        String?
  gtin       String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers         ProductOffer[]
  watchlistItems WatchlistItem[]
  priceAlerts    PriceAlert[]

  @@unique([productId, variantKey])
  /// Target of the offer's composite FK (variantId, productId).
  @@unique([id, productId])
  /// Specification filters use JSONB containment (attributes @> {...}).
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "ProductVariant_attributes_gin_idx")
  @@index([sku])
}

// ═══════════════════════════════ SHOPPING (global) ═══════════════════════════════

enum SourceIntegrationKind {
  OFFICIAL_API
  AFFILIATE_FEED
  PARTNER
  DISCOVERY
}

enum SourceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

/// Admin/integration status of a source. Runtime health (DEGRADED/FAILED)
/// is tracked separately in `health` and combined by the API.
enum SourceStatus {
  /// Authorized integration configured; eligible for searches and imports.
  ACTIVE
  /// Integration exists or is possible, but credentials are not configured.
  PENDING_CREDENTIALS
  /// The marketplace must approve access (partner/affiliate programme) first.
  PENDING_APPROVAL
  /// No authorized integration (the default).
  DISABLED
  /// Temporarily paused by an admin.
  MAINTENANCE
}

model ShoppingSource {
  id                      String                @id @default(uuid(7)) @db.Uuid
  /// Stable connector key, e.g. "amazon_in", "flipkart".
  slug                    String                @unique
  name                    String
  /// Registrable domain, e.g. "amazon.in".
  domain                  String
  baseUrl                 String
  logoUrl                 String?
  integrationKind         SourceIntegrationKind
  /// DISABLED by default; ACTIVE only once authorized credentials exist.
  status                  SourceStatus          @default(DISABLED)
  capabilities            Json                  @default("{}")
  timeoutMs               Int                   @default(8000)
  rateLimitPerMinute      Int                   @default(60)
  maxRetries              Int                   @default(2)
  affiliateEnabled        Boolean               @default(false)
  /// Development sample data only (fictional store, example.com URLs, made-up
  /// prices). Clients must label its offers as sample data, never as real.
  isSample                Boolean               @default(false)
  health                  SourceHealth          @default(UNKNOWN)
  lastHealthCheckAt       DateTime?
  lastHealthError         String?
  /// Why the source has its status (e.g. which approval is pending). Never secrets.
  statusReason            String?
  /// Last successful connector execution (search or health check).
  lastSuccessAt           DateTime?
  /// TTL for cached connector responses (seconds; 0 disables).
  cacheTtlSeconds         Int                   @default(300)
  /// Consecutive failures that open the circuit breaker.
  circuitFailureThreshold Int                   @default(5)
  /// How long an open circuit rejects calls before a half-open probe.
  circuitOpenSeconds      Int                   @default(60)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  offers               ProductOffer[]
  searchRuns           SearchSourceRun[]
  priceAlerts          PriceAlert[]
  affiliateClicks      AffiliateClick[]
  affiliateConversions AffiliateConversion[]
  matchReviews         ProductMatchReview[]

  @@index([status])
}

enum StockStatus {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

/// How an incoming listing was matched to the catalog.
enum MatchMethod {
  IDENTIFIER
  MODEL_NUMBER
  NORMALIZED_TITLE
  FUZZY_TITLE
  MANUAL
  NEW_PRODUCT
}

/// A listing of a variant on a source. Prices come only from source data.
model ProductOffer {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// Denormalized for lookups; must equal the variant's product (composite FK).
  productId         String      @db.Uuid
  variantId         String      @db.Uuid
  sourceId          String      @db.Uuid
  externalId        String
  productUrl        String
  /// Original marketplace title, preserved verbatim.
  title             String
  sellerName        String?
  mrpPaise          BigInt?
  sellingPricePaise BigInt
  shippingPaise     BigInt?
  stockStatus       StockStatus @default(UNKNOWN)
  /// ISO 4217; DealMind is INR-only (CHECK constraint).
  currency          String      @default("INR") @db.Char(3)
  /// Source-specific terms (bank offers, exchange, EMI), as published.
  offerConditions   Json        @default("{}")
  /// When the source says it last updated the listing (if provided).
  sourceUpdatedAt   DateTime?
  /// When DealMind last observed the listing.
  observedAt        DateTime    @default(now())
  firstSeenAt       DateTime    @default(now())
  /// When set, the offer is scheduled for background price tracking.
  trackedUntil      DateTime?
  matchMethod       MatchMethod @default(MANUAL)
  /// Matching confidence in basis points (0–10000).
  matchConfidence   Int         @default(10000)
  /// Signals that justified the match (identifier, model number, similarity…).
  matchEvidence     Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant   @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  source          ShoppingSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  snapshots       PriceSnapshot[]
  searchResults   SearchResult[]
  affiliateClicks AffiliateClick[]

  @@unique([sourceId, externalId])
  @@index([variantId, sellingPricePaise])
  @@index([productId, sellingPricePaise])
  @@index([trackedUntil])
}

/// Append-only price history (UPDATEs are rejected by a database trigger).
model PriceSnapshot {
  id                String      @id @default(uuid(7)) @db.Uuid
  offerId           String      @db.Uuid
  mrpPaise          BigInt?
  sellingPricePaise BigInt
  shippingPaise     BigInt?
  stockStatus       StockStatus
  observedAt        DateTime    @default(now())

  offer ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, observedAt(sort: Desc)])
}

enum MatchReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An incoming listing whose catalog match was uncertain. Held for manual
/// review instead of being merged (or duplicated) automatically.
model ProductMatchReview {
  id                 String            @id @default(uuid(7)) @db.Uuid
  sourceId           String            @db.Uuid
  externalId         String
  /// The validated, normalized listing as received (for replay on approval).
  listing            Json
  candidateProductId String?           @db.Uuid
  confidence         Int
  method             MatchMethod
  evidence           Json              @default("{}")
  status             MatchReviewStatus @default(PENDING)
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  source           ShoppingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  candidateProduct Product?       @relation(fields: [candidateProductId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([status, createdAt])
}

// ═══════════════════════════════ SEARCH (user-owned) ═══════════════════════════════

enum SearchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  /// The query was contradictory or too vague; the agent asked a question instead of guessing.
  NEEDS_CLARIFICATION
  /// Cancelled by its owner before completion.
  CANCELLED
}

model Search {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @db.Uuid
  query       String
  /// Structured intent extracted by the AI layer (validated by Zod before storage).
  intent      Json?
  /// Hard filters applied deterministically (price range in paise, brands, specs).
  filters     Json         @default("{}")
  status      SearchStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRuns SearchSourceRun[]
  results    SearchResult[]
  agentRuns  AgentRun[]

  /// Target of composite ownership foreign keys from child rows.
  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
}

enum SourceRunStatus {
  SUCCEEDED
  FAILED
  TIMED_OUT
  SKIPPED
}

/// Per-source outcome of a search: enables partial results and error reporting.
model SearchSourceRun {
  id           String          @id @default(uuid(7)) @db.Uuid
  userId       String          @db.Uuid
  searchId     String          @db.Uuid
  sourceId     String          @db.Uuid
  status       SourceRunStatus
  resultCount  Int             @default(0)
  durationMs   Int
  errorCode    String?
  errorMessage String?
  createdAt    DateTime        @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search         @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)
  source ShoppingSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([searchId, sourceId])
  @@index([userId])
}

model SearchResult {
  id                 String  @id @default(uuid(7)) @db.Uuid
  userId             String  @db.Uuid
  searchId           String  @db.Uuid
  offerId            String  @db.Uuid
  /// 1-based position in the deterministic ranking.
  rank               Int
  /// Deterministic ranking score (higher is better), scaled integer.
  score              Int
  /// Price/MRP at search time, so history does not change when offers update.
  pricePaiseAtSearch BigInt
  mrpPaiseAtSearch   BigInt?
  explanation        String?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search       @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)
  offer  ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([searchId, offerId])
  @@unique([searchId, rank])
  @@index([userId])
  @@index([offerId])
}

// ═══════════════════════════════ USER FEATURES (user-owned) ═══════════════════════════════

model Watchlist {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([id, userId])
  @@unique([userId, name])
}

model WatchlistItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  watchlistId String   @db.Uuid
  variantId   String   @db.Uuid
  note        String?
  addedAt     DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist      @relation(fields: [watchlistId, userId], references: [id, userId], onDelete: Cascade)
  /// Restrict: catalog merges must re-point watchlist items, never drop them silently.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([watchlistId, variantId])
  @@index([userId])
  @@index([variantId])
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
}

model PriceAlert {
  id                      String      @id @default(uuid(7)) @db.Uuid
  userId                  String      @db.Uuid
  variantId               String      @db.Uuid
  /// Restrict to one source; null = any enabled source.
  sourceId                String?     @db.Uuid
  targetPricePaise        BigInt
  status                  AlertStatus @default(ACTIVE)
  lastTriggeredAt         DateTime?
  lastTriggeredPricePaise BigInt?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  source  ShoppingSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  /// One alert per user/variant/source. NULL sourceId is also de-duplicated
  /// (NULLS NOT DISTINCT, applied in the constraints migration).
  @@unique([userId, variantId, sourceId])
  /// Alert evaluation scans active alerts for a variant.
  @@index([variantId, status])
}

enum NotificationType {
  PRICE_DROP
  TARGET_PRICE_REACHED
  BACK_IN_STOCK
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([id, userId])
  @@index([userId, readAt, createdAt(sort: Desc)])
}

enum DeliveryChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One delivery attempt record per channel for a notification.
model NotificationDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  userId            String          @db.Uuid
  notificationId    String          @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(PENDING)
  attempts          Int             @default(0)
  lastError         String?
  providerMessageId String?
  scheduledAt       DateTime        @default(now())
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([userId])
  /// Delivery worker polls pending deliveries in schedule order.
  @@index([status, scheduledAt])
}

// ═══════════════════════════════ AI (user-owned) ═══════════════════════════════

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Private record of an AI graph execution, owned by the requesting user.
model AgentRun {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @db.Uuid
  searchId     String?        @db.Uuid
  graph        String
  model        String
  status       AgentRunStatus @default(RUNNING)
  input        Json
  output       Json?
  error        String?
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  /// LLM provider used ("openai", "google", "rules"…); never credentials.
  provider     String         @default("")
  /// LangGraph checkpoint thread id (stable per run; resumes after a retry).
  threadId     String?        @unique
  /// Execution attempts (BullMQ retries resume from the last checkpoint).
  attempts     Int            @default(0)
  durationMs   Int?
  /// Node timings, iteration count, connector summary (no user secrets).
  metadata     Json           @default("{}")
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Composite FK: a run can only reference a search owned by the same user.
  search Search? @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([searchId])
}

enum AiPurpose {
  INTENT_EXTRACTION
  SEARCH_PLANNING
  PRODUCT_EVALUATION
  RESULT_EXPLANATION
}

/// Global AI configuration, managed by admins.
model AiModelConfig {
  id          String    @id @default(uuid(7)) @db.Uuid
  purpose     AiPurpose @unique
  provider    String
  model       String
  temperature Float     @default(0)
  maxTokens   Int       @default(1024)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ═══════════════════════════════ MONETIZATION ═══════════════════════════════

enum PlanCode {
  FREE
  PRO
  BUSINESS
}

/// Global plan catalogue (admin-managed).
model SubscriptionPlan {
  code              PlanCode @id
  name              String
  monthlyPricePaise BigInt
  /// Usage limits, e.g. { "searchesPerDay": 20, "activeAlerts": 5, "watchlists": 2 }.
  limits            Json
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Subscriptions belong to individual users (one current subscription each).
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @unique @db.Uuid
  planCode           PlanCode           @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  provider           String?
  providerRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@unique([provider, providerRef])
  @@index([planCode, status])
}

enum UsageMetric {
  SEARCH
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  ALERT_CREATED
}

/// Append-only metering, aggregated per period to enforce plan limits.
model UsageRecord {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @db.Uuid
  metric     UsageMetric
  quantity   Int         @default(1)
  occurredAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metric, occurredAt])
}

model AffiliateClick {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Opaque reference appended to the affiliate link for attribution.
  clickRef  String   @unique
  /// Null for anonymous visitors; set to NULL when a user is deleted so revenue
  /// reporting survives account deletion.
  userId    String?  @db.Uuid
  offerId   String   @db.Uuid
  sourceId  String   @db.Uuid
  /// Salted hash only; raw IP addresses are never stored.
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  offer       ProductOffer          @relation(fields: [offerId], references: [id], onDelete: Restrict)
  source      ShoppingSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  conversions AffiliateConversion[]

  @@index([userId])
  @@index([sourceId, createdAt])
  @@index([offerId])
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Global affiliate revenue reporting, imported from affiliate networks.
model AffiliateConversion {
  id               String           @id @default(uuid(7)) @db.Uuid
  clickId          String?          @db.Uuid
  sourceId         String           @db.Uuid
  externalOrderRef String
  orderAmountPaise BigInt
  commissionPaise  BigInt
  status           ConversionStatus @default(PENDING)
  reportedAt       DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  click  AffiliateClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)
  source ShoppingSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalOrderRef])
  @@index([clickId])
}

enum BillingEventType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_CANCELED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_ISSUED
}

/// Immutable ledger of billing events from the payment provider.
/// Restrict on user delete: financial records must be retained, so users with
/// billing history are anonymised/suspended rather than hard-deleted.
model BillingEvent {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @db.Uuid
  subscriptionId  String?          @db.Uuid
  type            BillingEventType
  provider        String
  /// Provider's event id: makes webhook processing idempotent.
  providerEventId String
  amountPaise     BigInt?
  planCode        PlanCode?
  payload         Json             @default("{}")
  occurredAt      DateTime
  createdAt       DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([subscriptionId])
}

// ═══════════════════════════════ PLATFORM (global) ═══════════════════════════════

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
