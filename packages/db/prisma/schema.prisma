// DealMind AI — single-platform, multi-user data model.
//
// There is NO multi-tenancy: no Tenant, Organization or Membership models and
// no tenantId / organizationId / membershipId columns. Data falls into:
//
//   * GLOBAL (shared by every user): Category, Product, ProductVariant,
//     ShoppingSource, ProductOffer, PriceSnapshot, SubscriptionPlan,
//     AffiliateConversion, AiModelConfig, PlatformSetting, AuditLog.
//
//   * USER-OWNED: every model carries a non-null `userId` foreign key to User:
//     UserSession, UserPreference, Search, SearchSourceRun, SearchResult,
//     Watchlist, WatchlistItem, PriceAlert, Notification, NotificationDelivery,
//     AgentRun, Subscription, UsageRecord, BillingEvent.
//     (AffiliateClick.userId is nullable: anonymous visitors can click too.)
//
// OWNERSHIP IS ENFORCED BY THE DATABASE. A child of a user-owned parent
// (e.g. WatchlistItem → Watchlist) references the parent through a composite
// foreign key (parentId, userId) → parent(id, userId), so a row can never be
// attached to another user's parent, even if application code is wrong.
//
// Conventions:
//   * Primary keys: UUIDv7 (time-ordered → compact B-tree indexes), native `uuid`.
//   * Money: integer paise (`Int`; `BigInt` for aggregates). No floats.
//   * Json columns are PostgreSQL `jsonb`.
//   * CHECK constraints that Prisma cannot express live in the migration
//     `*_constraints/migration.sql` and are covered by tests.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════ IDENTITY ═══════════════════════════════

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Local mirror of an identity owned by the shared EasyDev IAM. Credentials,
/// email verification, password reset and 2FA live in the IAM; DealMind keeps
/// this row so its own data can reference users by foreign key, plus the
/// DealMind-specific role and status. Profile fields are synced at sign-in.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// The IAM user id (JWT `sub`). Immutable link to the IAM identity.
  iamUserId       String     @unique @db.Uuid
  /// Always stored lower-case (CHECK constraint), so uniqueness is case-insensitive.
  email           String     @unique
  name            String
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions               UserSession[]
  preference             UserPreference?
  searches               Search[]
  searchSourceRuns       SearchSourceRun[]
  searchResults          SearchResult[]
  watchlists             Watchlist[]
  watchlistItems         WatchlistItem[]
  priceAlerts            PriceAlert[]
  alertEvaluations       AlertEvaluation[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  checkoutSessions       CheckoutSession[]
  usageCounters          UsageCounter[]
  notificationDeliveries NotificationDelivery[]
  agentRuns              AgentRun[]
  subscription           Subscription?
  usageRecords           UsageRecord[]
  affiliateClicks        AffiliateClick[]
  billingEvents          BillingEvent[]
  auditLogs              AuditLog[]

  @@index([role])
  @@index([createdAt])
}

/// Server-side browser session. The opaque token lives only in an HttpOnly
/// cookie; the database stores its SHA-256 hash.
model UserSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  /// Rotation family: presenting a rotated-away token revokes the whole family.
  familyId     String    @db.Uuid
  /// Absolute expiry.
  expiresAt    DateTime
  /// Drives the idle timeout; refreshed (throttled) on authenticated requests.
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  /// The IAM session behind this DealMind session (from the IAM access token).
  iamSessionId             String?  @db.Uuid
  /// The user's IAM tokens, AES-256-GCM encrypted with TOKEN_ENCRYPTION_KEY.
  /// They never leave the server: the browser only holds the DealMind cookie.
  iamAccessTokenEnc        String
  iamAccessTokenExpiresAt  DateTime
  iamRefreshTokenEnc       String
  iamRefreshTokenExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([iamSessionId])
}

model UserPreference {
  id                     String   @id @default(uuid(7)) @db.Uuid
  userId                 String   @unique @db.Uuid
  preferredSourceIds     String[] @db.Uuid
  preferredBrands        String[]
  notifyEmail            Boolean  @default(true)
  notifyInApp            Boolean  @default(true)
  /// Global browser-push switch; off until the user enables it (needs a subscription too).
  notifyPush             Boolean  @default(false)
  /// Per-category channel switches {PRICE_ALERTS|SEARCH|ACCOUNT: {inApp,email,push}}; validated by
  /// `categoryChannelsOf` in @dealmind/shared (missing keys fall back to defaults).
  notificationCategories Json     @default("{}")
  /// Quiet hours ("HH:MM", local to `timezone`): email and push of non-critical notifications wait until they end.
  quietHoursStart        String?
  quietHoursEnd          String?
  timezone               String   @default("Asia/Kolkata")
  locale                 String   @default("en-IN")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════ CATALOG (global) ═══════════════════════════════

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?  @db.Uuid
  /// Inactive categories are hidden from browsing but keep their products.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

/// A canonical product, shared by every user. Identifiers are unique only when
/// present (NULLs never collide). Specifications come only from verified
/// source data and are never generated.
model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  categoryId     String?   @db.Uuid
  /// Display name (canonical).
  name           String
  /// Lower-cased, punctuation-free form of `name`, used for matching.
  normalizedName String
  /// Canonical brand (see @dealmind/catalog normalizeBrand).
  brand          String
  description    String?
  manufacturer   String?
  /// Manufacturer model / part number as published.
  modelNumber    String?
  gtin           String?   @unique
  ean            String?   @unique
  upc            String?   @unique
  specifications Json      @default("{}")
  launchDate     DateTime?
  imageUrl       String?
  isActive       Boolean   @default(true)
  /// Deterministic key: canonical brand + normalized model number (when known).
  fingerprint    String?   @unique
  firstSeenAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  offers   ProductOffer[]
  reviews  ProductMatchReview[]

  @@index([brand])
  @@index([categoryId, isActive])
  @@index([launchDate])
  /// Fuzzy title search (pg_trgm) on the display name and the normalized name.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_normalizedName_trgm_idx")
}

model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @db.Uuid
  /// Canonical attribute key, e.g. "color=black|ram=8gb|storage=128gb".
  /// Different RAM/storage/capacity/colour never share a key.
  variantKey String
  attributes Json     @default("{}")
  sku        String?
  /// Manufacturer part number (identifies one configuration, e.g. "SM-S931BZBCINS").
  mpn        String?
  gtin       String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers         ProductOffer[]
  watchlistItems WatchlistItem[]
  priceAlerts    PriceAlert[]

  @@unique([productId, variantKey])
  /// Target of the offer's composite FK (variantId, productId).
  @@unique([id, productId])
  /// Specification filters use JSONB containment (attributes @> {...}).
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "ProductVariant_attributes_gin_idx")
  @@index([sku])
  @@index([mpn])
}

// ═══════════════════════════════ SHOPPING (global) ═══════════════════════════════

enum SourceIntegrationKind {
  OFFICIAL_API
  AFFILIATE_FEED
  PARTNER
  DISCOVERY
}

enum SourceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

/// Admin/integration status of a source. Runtime health (DEGRADED/FAILED)
/// is tracked separately in `health` and combined by the API.
enum SourceStatus {
  /// Authorized integration configured; eligible for searches and imports.
  ACTIVE
  /// Integration exists or is possible, but credentials are not configured.
  PENDING_CREDENTIALS
  /// The marketplace must approve access (partner/affiliate programme) first.
  PENDING_APPROVAL
  /// No authorized integration (the default).
  DISABLED
  /// Temporarily paused by an admin.
  MAINTENANCE
}

model ShoppingSource {
  id                      String                @id @default(uuid(7)) @db.Uuid
  /// Stable connector key, e.g. "amazon_in", "flipkart".
  slug                    String                @unique
  name                    String
  /// Registrable domain, e.g. "amazon.in".
  domain                  String
  baseUrl                 String
  logoUrl                 String?
  integrationKind         SourceIntegrationKind
  /// DISABLED by default; ACTIVE only once authorized credentials exist.
  status                  SourceStatus          @default(DISABLED)
  capabilities            Json                  @default("{}")
  timeoutMs               Int                   @default(8000)
  rateLimitPerMinute      Int                   @default(60)
  maxRetries              Int                   @default(2)
  affiliateEnabled        Boolean               @default(false)
  /// Development sample data only (fictional store, example.com URLs, made-up
  /// prices). Clients must label its offers as sample data, never as real.
  isSample                Boolean               @default(false)
  health                  SourceHealth          @default(UNKNOWN)
  lastHealthCheckAt       DateTime?
  lastHealthError         String?
  /// Why the source has its status (e.g. which approval is pending). Never secrets.
  statusReason            String?
  /// Last successful connector execution (search or health check).
  lastSuccessAt           DateTime?
  /// TTL for cached connector responses (seconds; 0 disables).
  cacheTtlSeconds         Int                   @default(300)
  /// Consecutive failures that open the circuit breaker.
  circuitFailureThreshold Int                   @default(5)
  /// How long an open circuit rejects calls before a half-open probe.
  circuitOpenSeconds      Int                   @default(60)
  /// Background price tracking for this source (still requires ACTIVE status and a lookup-capable connector).
  trackingEnabled         Boolean               @default(true)
  /// Refresh intervals by demand tier (minutes). Configurable per source; respect the marketplace's permitted usage.
  trackingHighMinutes     Int                   @default(30)
  trackingNormalMinutes   Int                   @default(180)
  trackingLowMinutes      Int                   @default(720)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  offers               ProductOffer[]
  priceChecks          PriceCheck[]
  searchRuns           SearchSourceRun[]
  priceAlerts          PriceAlert[]
  affiliateClicks      AffiliateClick[]
  affiliateConversions AffiliateConversion[]
  affiliatePayouts     AffiliatePayout[]
  matchReviews         ProductMatchReview[]

  @@index([status])
}

enum OfferTrackingState {
  ACTIVE
  MISSING
  EXPIRED
}

/// Outcome of one global tracking check of one offer (append-only, retention-limited).
enum PriceCheckOutcome {
  UNCHANGED
  PRICE_DECREASED
  PRICE_INCREASED
  /// Price unchanged; stock, MRP or shipping changed.
  OTHER_CHANGED
  /// The listing reappeared after being missing.
  REAPPEARED
  MISSING
  /// Rejected data (validation failed or an implausible change awaiting confirmation).
  INVALID
  FAILED
  SKIPPED
  RATE_LIMITED
}

/// One background price check of one marketplace offer. Shared by all users.
model PriceCheck {
  id                 String            @id @default(uuid(7)) @db.Uuid
  offerId            String            @db.Uuid
  sourceId           String            @db.Uuid
  outcome            PriceCheckOutcome
  previousPricePaise BigInt?
  newPricePaise      BigInt?
  /// new − previous (signed, paise); null unless both prices are valid observations.
  changePaise        BigInt?
  /// Change in basis points of the previous price (signed, truncated toward zero).
  changeBp           Int?
  previousStock      StockStatus?
  newStock           StockStatus?
  /// The snapshot written by this check, if any.
  snapshotId         String?           @db.Uuid
  attempt            Int               @default(1)
  durationMs         Int               @default(0)
  errorCode          String?
  errorMessage       String?
  checkedAt          DateTime          @default(now())

  offer       ProductOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  source      ShoppingSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evaluations AlertEvaluation[]

  @@index([offerId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@index([sourceId, checkedAt])
}

enum StockStatus {
  IN_STOCK
  LIMITED
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

/// How an incoming listing was matched to the catalog.
enum MatchMethod {
  IDENTIFIER
  /// Manufacturer part number (one configuration).
  MPN
  MODEL_NUMBER
  NORMALIZED_TITLE
  FUZZY_TITLE
  /// Optional embedding similarity (pgvector); never auto-merges.
  SEMANTIC
  MANUAL
  NEW_PRODUCT
}

/// A listing of a variant on a source. Prices come only from source data.
model ProductOffer {
  id                  String             @id @default(uuid(7)) @db.Uuid
  /// Denormalized for lookups; must equal the variant's product (composite FK).
  productId           String             @db.Uuid
  variantId           String             @db.Uuid
  sourceId            String             @db.Uuid
  externalId          String
  productUrl          String
  /// productUrl without tracking parameters; detects one listing under two external ids.
  canonicalUrl        String?
  /// Original marketplace title, preserved verbatim.
  title               String
  sellerName          String?
  mrpPaise            BigInt?
  sellingPricePaise   BigInt
  shippingPaise       BigInt?
  stockStatus         StockStatus        @default(UNKNOWN)
  /// ISO 4217; DealMind is INR-only (CHECK constraint).
  currency            String             @default("INR") @db.Char(3)
  /// Source-specific terms (bank offers, exchange, EMI), as published.
  offerConditions     Json               @default("{}")
  /// When the source says it last updated the listing (if provided).
  sourceUpdatedAt     DateTime?
  /// When DealMind last observed the listing.
  observedAt          DateTime           @default(now())
  firstSeenAt         DateTime           @default(now())
  /// Optional end of background tracking for this offer (null = no end).
  trackedUntil        DateTime?
  /// Lifecycle seen by tracking: ACTIVE, MISSING (the source no longer returns it), EXPIRED (missing too long).
  trackingState       OfferTrackingState @default(ACTIVE)
  /// Last tracking attempt (any outcome) and the next due time (null = due now).
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime?
  /// Consecutive failed tracking attempts (drives backoff).
  consecutiveFailures Int                @default(0)
  /// First tracking check that did not find the listing.
  missingSince        DateTime?
  matchMethod         MatchMethod        @default(MANUAL)
  /// Matching confidence in basis points (0–10000).
  matchConfidence     Int                @default(10000)
  /// Signals that justified the match (identifier, model number, similarity…).
  matchEvidence       Json               @default("{}")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant    @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  source           ShoppingSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  snapshots        PriceSnapshot[]
  priceChecks      PriceCheck[]
  alertEvaluations AlertEvaluation[]
  searchResults    SearchResult[]
  affiliateClicks  AffiliateClick[]

  @@unique([sourceId, externalId])
  @@index([sourceId, canonicalUrl])
  /// The tracking scheduler scans due offers.
  @@index([trackingState, nextCheckAt])
  @@index([variantId, sellingPricePaise])
  @@index([productId, sellingPricePaise])
  @@index([trackedUntil])
}

/// Append-only price history (UPDATEs are rejected by a database trigger).
model PriceSnapshot {
  id                String      @id @default(uuid(7)) @db.Uuid
  offerId           String      @db.Uuid
  mrpPaise          BigInt?
  sellingPricePaise BigInt
  shippingPaise     BigInt?
  stockStatus       StockStatus
  observedAt        DateTime    @default(now())

  offer ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, observedAt(sort: Desc)])
}

enum MatchReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An incoming listing whose catalog match was uncertain. Held for manual
/// review instead of being merged (or duplicated) automatically.
model ProductMatchReview {
  id                 String            @id @default(uuid(7)) @db.Uuid
  sourceId           String            @db.Uuid
  externalId         String
  /// The validated, normalized listing as received (for replay on approval).
  listing            Json
  candidateProductId String?           @db.Uuid
  confidence         Int
  method             MatchMethod
  evidence           Json              @default("{}")
  status             MatchReviewStatus @default(PENDING)
  reviewedAt         DateTime?
  /// Audit record of the decision that sent this listing to review.
  auditId            String?           @db.Uuid
  /// Human reviewer (admin user id); never an AI.
  reviewedBy         String?           @db.Uuid
  reviewNote         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  source           ShoppingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  candidateProduct Product?       @relation(fields: [candidateProductId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([status, createdAt])
}

enum MatchConfidence {
  /// 98–100
  VERY_HIGH
  /// 90–97
  HIGH
  /// 75–89: manual review
  REVIEW
  /// < 75: do not merge
  LOW
}

enum MatchDecisionKind {
  /// Same product (existing or new variant) — applied automatically.
  AUTO_MERGE
  /// No safe candidate: a new product.
  NEW_PRODUCT
  /// Uncertain: held for a human reviewer.
  MANUAL_REVIEW
  /// Compared and judged different (e.g. a critical attribute conflicts).
  NO_MATCH
  /// The listing duplicates an existing offer of the same source.
  DUPLICATE_OFFER
  /// A human reviewer's resolution of an earlier MANUAL_REVIEW.
  REVIEW_RESOLVED
}

enum MatchSubjectKind {
  /// An incoming marketplace listing vs the catalog.
  LISTING
  /// Two existing catalog products (duplicate detection).
  PRODUCT_PAIR
}

enum MatchOrigin {
  IMPORT
  INTERNAL_API
  DUPLICATE_SCAN
  REVIEW
}

/// Append-only audit of every matching decision (UPDATE rejected by trigger).
/// Product/variant ids are kept as plain ids so history survives merges.
model ProductMatchAudit {
  id                 String            @id @default(uuid(7)) @db.Uuid
  subject            MatchSubjectKind
  origin             MatchOrigin
  sourceId           String?           @db.Uuid
  externalId         String?
  /// The listing as compared (LISTING subjects).
  listing            Json?
  /// PRODUCT_PAIR: the first product.
  productAId         String?           @db.Uuid
  /// The best candidate (LISTING) or the second product (PRODUCT_PAIR).
  candidateProductId String?           @db.Uuid
  candidateVariantId String?           @db.Uuid
  /// What was written as a result (if anything).
  resultProductId    String?           @db.Uuid
  resultVariantId    String?           @db.Uuid
  /// 0–10000 (= score 0.00–100.00).
  scoreBp            Int
  confidence         MatchConfidence
  decision           MatchDecisionKind
  method             MatchMethod
  evidence           Json              @default("{}")
  conflicts          Json              @default("[]")
  engineVersion      String
  /// REVIEW_RESOLVED rows point at the decision they resolve.
  reviewOfId         String?           @db.Uuid
  /// Human reviewer (admin user id) for REVIEW_RESOLVED rows.
  reviewer           String?           @db.Uuid
  note               String?
  createdAt          DateTime          @default(now())

  reviewOf ProductMatchAudit?  @relation("MatchAuditReview", fields: [reviewOfId], references: [id], onDelete: Restrict)
  reviews  ProductMatchAudit[] @relation("MatchAuditReview")

  @@index([sourceId, externalId])
  @@index([candidateProductId])
  @@index([productAId])
  @@index([decision, createdAt])
  @@index([reviewOfId])
}

// ═══════════════════════════════ SEARCH (user-owned) ═══════════════════════════════

enum SearchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  /// The query was contradictory or too vague; the agent asked a question instead of guessing.
  NEEDS_CLARIFICATION
  /// Cancelled by its owner before completion.
  CANCELLED
}

model Search {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @db.Uuid
  query       String
  /// Structured intent extracted by the AI layer (validated by Zod before storage).
  intent      Json?
  /// Hard filters applied deterministically (price range in paise, brands, specs).
  filters     Json         @default("{}")
  status      SearchStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRuns SearchSourceRun[]
  results    SearchResult[]
  agentRuns  AgentRun[]

  /// Target of composite ownership foreign keys from child rows.
  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
}

enum SourceRunStatus {
  SUCCEEDED
  FAILED
  TIMED_OUT
  SKIPPED
}

/// Per-source outcome of a search: enables partial results and error reporting.
model SearchSourceRun {
  id           String          @id @default(uuid(7)) @db.Uuid
  userId       String          @db.Uuid
  searchId     String          @db.Uuid
  sourceId     String          @db.Uuid
  status       SourceRunStatus
  resultCount  Int             @default(0)
  durationMs   Int
  errorCode    String?
  errorMessage String?
  createdAt    DateTime        @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search         @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)
  source ShoppingSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([searchId, sourceId])
  @@index([userId])
}

model SearchResult {
  id                 String  @id @default(uuid(7)) @db.Uuid
  userId             String  @db.Uuid
  searchId           String  @db.Uuid
  offerId            String  @db.Uuid
  /// 1-based position in the deterministic ranking.
  rank               Int
  /// Deterministic ranking score (higher is better), scaled integer.
  score              Int
  /// Price/MRP at search time, so history does not change when offers update.
  pricePaiseAtSearch BigInt
  mrpPaiseAtSearch   BigInt?
  explanation        String?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  search Search       @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)
  offer  ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([searchId, offerId])
  @@unique([searchId, rank])
  @@index([userId])
  @@index([offerId])
}

// ═══════════════════════════════ USER FEATURES (user-owned) ═══════════════════════════════

model Watchlist {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([id, userId])
  @@unique([userId, name])
}

model WatchlistItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  watchlistId String   @db.Uuid
  variantId   String   @db.Uuid
  note        String?
  addedAt     DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist      @relation(fields: [watchlistId, userId], references: [id, userId], onDelete: Cascade)
  /// Restrict: catalog merges must re-point watchlist items, never drop them silently.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([watchlistId, variantId])
  @@index([userId])
  @@index([variantId])
}

/// Lifecycle (transitions validated by the API; see docs/ALERTS.md):
/// ACTIVE ⇄ PAUSED; ACTIVE → TRIGGERED (one-shot alert met) → ACTIVE (re-armed);
/// ACTIVE/PAUSED/TRIGGERED → EXPIRED (expiresAt passed) or CANCELLED (by the user).
enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
  EXPIRED
  CANCELLED
}

enum AlertType {
  /// Delivered price at or below the target.
  TARGET_PRICE
  /// Delivered price strictly below the target.
  PRICE_BELOW
  /// Delivered price dropped by at least dropPercentBp from the baseline.
  PERCENT_DROP
  /// Delivered price below every observation in the last historicalWindowDays (with enough history).
  HISTORICAL_LOW
  /// Any observed price change (optionally on one marketplace, optionally by at least minChangePaise).
  PRICE_CHANGE
  /// Out of stock or missing, then available again.
  BACK_IN_STOCK
  /// An observed price decrease (typically on a preferred marketplace), optionally by at least minChangePaise.
  PRICE_DROP
}

enum AlertEvaluationOutcome {
  TRIGGERED
  NOT_MET
  COOLDOWN
  /// Condition met, but the user turned off every notification channel.
  SUPPRESSED
  /// Not enough verified data to decide (never treated as met).
  INSUFFICIENT_DATA
}

/// One evaluation of one user's alert against one global price check (idempotent per check).
model AlertEvaluation {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  userId             String                 @db.Uuid
  alertId            String                 @db.Uuid
  /// The global check evaluated (null once the check is pruned; the evaluation is kept).
  checkId            String?                @db.Uuid
  offerId            String                 @db.Uuid
  outcome            AlertEvaluationOutcome
  observedPricePaise BigInt?
  reason             String
  notificationId     String?                @db.Uuid
  evaluatedAt        DateTime               @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert PriceAlert   @relation(fields: [alertId, userId], references: [id, userId], onDelete: Cascade)
  check PriceCheck?  @relation(fields: [checkId], references: [id], onDelete: SetNull)
  offer ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([alertId, checkId])
  @@index([userId, evaluatedAt(sort: Desc)])
  @@index([alertId, evaluatedAt(sort: Desc)])
  @@index([evaluatedAt])
}

model PriceAlert {
  id                      String            @id @default(uuid(7)) @db.Uuid
  userId                  String            @db.Uuid
  variantId               String            @db.Uuid
  /// Restrict to one source; null = any enabled source.
  sourceId                String?           @db.Uuid
  type                    AlertType         @default(TARGET_PRICE)
  /// Required for TARGET_PRICE and PRICE_BELOW.
  targetPricePaise        BigInt?
  /// Required for PERCENT_DROP (basis points, 1–9000).
  dropPercentBp           Int?
  /// PERCENT_DROP reference price (set when the alert is created or first evaluated).
  baselinePricePaise      BigInt?
  /// HISTORICAL_LOW window (days).
  historicalWindowDays    Int?
  /// Minimum time between two notifications of this alert.
  cooldownMinutes         Int               @default(1440)
  status                  AlertStatus       @default(ACTIVE)
  lastTriggeredAt         DateTime?
  lastTriggeredPricePaise BigInt?
  lastEvaluatedAt         DateTime?
  /// PRICE_CHANGE / PRICE_DROP: minimum absolute change (paise) that counts.
  minChangePaise          BigInt?
  /// false: a met condition ends the alert (TRIGGERED, re-armable); true: keeps watching (cooldown applies).
  repeat                  Boolean           @default(false)
  /// The alert stops (EXPIRED) after this time; null = no end.
  expiresAt               DateTime?
  /// Channels this alert may use (further limited by the user's preferences).
  channels                DeliveryChannel[] @default([IN_APP, EMAIL])
  triggerCount            Int               @default(0)
  cancelledAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  source      ShoppingSource?   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  evaluations AlertEvaluation[]

  /// One alert per user/variant/source/type. NULL sourceId is also de-duplicated
  /// (NULLS NOT DISTINCT, applied in SQL).
  @@unique([userId, variantId, sourceId, type])
  @@unique([id, userId])
  /// Alert evaluation scans active alerts for a variant.
  @@index([variantId, status])
  /// Expiry scan (cleanup).
  @@index([status, expiresAt])
}

enum NotificationType {
  PRICE_DROP
  TARGET_PRICE_REACHED
  BACK_IN_STOCK
  PRICE_CHANGED
  ALERT_EXPIRED
  SEARCH_COMPLETED
  SEARCH_FAILED
  PASSWORD_CHANGED
  NEW_SIGN_IN
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  PAYMENT_FAILED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_ENDED
  REFUND_UPDATED
  SYSTEM
}

enum NotificationCategory {
  PRICE_ALERTS
  SEARCH
  ACCOUNT
  BILLING
}

/// The verified event a notification came from.
enum NotificationSource {
  ALERT_EVALUATION
  ALERT_EXPIRY
  SEARCH
  ACCOUNT
  BILLING
}

model Notification {
  id         String               @id @default(uuid(7)) @db.Uuid
  userId     String               @db.Uuid
  type       NotificationType
  category   NotificationCategory
  /// Security notices: always in-app, never delayed by quiet hours.
  critical   Boolean              @default(false)
  sourceType NotificationSource
  /// Id of the source record (alert evaluation, alert, search, audit entry).
  sourceId   String
  /// One notification per user per event: a retried producer can't create a duplicate.
  dedupeKey  String
  title      String
  body       String
  /// Relative in-app link.
  link       String?
  data       Json                 @default("{}")
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([id, userId])
  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, category, createdAt(sort: Desc)])
}

enum DeliveryChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One delivery attempt record per channel for a notification.
model NotificationDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  userId            String          @db.Uuid
  notificationId    String          @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(PENDING)
  attempts          Int             @default(0)
  lastError         String?
  providerMessageId String?
  /// Push: subscriptions already delivered to (a retry sends only to the rest).
  sentTo            String[]        @default([]) @db.Uuid
  /// Not sent before this time (quiet hours).
  scheduledAt       DateTime        @default(now())
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([userId])
  /// Delivery worker polls pending deliveries in schedule order.
  @@index([status, scheduledAt])
}

// ═══════════════════════════════ AI (user-owned) ═══════════════════════════════

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Private record of an AI graph execution, owned by the requesting user.
model AgentRun {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @db.Uuid
  searchId     String?        @db.Uuid
  graph        String
  model        String
  status       AgentRunStatus @default(RUNNING)
  input        Json
  output       Json?
  error        String?
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  /// LLM provider used ("openai", "google", "rules"…); never credentials.
  provider     String         @default("")
  /// LangGraph checkpoint thread id (stable per run; resumes after a retry).
  threadId     String?        @unique
  /// Execution attempts (BullMQ retries resume from the last checkpoint).
  attempts     Int            @default(0)
  durationMs   Int?
  /// Node timings, iteration count, connector summary (no user secrets).
  metadata     Json           @default("{}")
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Composite FK: a run can only reference a search owned by the same user.
  search Search? @relation(fields: [searchId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([searchId])
}

enum AiPurpose {
  INTENT_EXTRACTION
  SEARCH_PLANNING
  PRODUCT_EVALUATION
  RESULT_EXPLANATION
}

/// Global AI configuration, managed by admins.
model AiModelConfig {
  id          String    @id @default(uuid(7)) @db.Uuid
  purpose     AiPurpose @unique
  provider    String
  model       String
  temperature Float     @default(0)
  maxTokens   Int       @default(1024)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ═══════════════════════════════ MONETIZATION ═══════════════════════════════

enum PlanCode {
  FREE
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Global plan catalogue (admin-managed): the single place prices, limits and
/// features are configured (validated against DEFAULT_PLANS' shape).
model SubscriptionPlan {
  code              PlanCode @id
  name              String
  description       String   @default("")
  monthlyPricePaise BigInt
  /// Null: no annual option.
  annualPricePaise  BigInt?
  /// Numeric limits (see PlanLimits in @dealmind/shared).
  limits            Json
  /// On/off features (see PlanFeatures in @dealmind/shared).
  features          Json     @default("{}")
  sortOrder         Int      @default(0)
  /// Plan ids in the shared EasyDev payment service per interval,
  /// e.g. { "MONTHLY": "<uuid>", "ANNUAL": "<uuid>" }; set by billing:sync-plans.
  providerPlanIds   Json     @default("{}")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions    Subscription[]
  checkoutSessions CheckoutSession[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  PAUSED
}

/// Subscriptions belong to individual users (one current subscription each).
/// For paid plans this is a mirror of the shared payment service's record,
/// written only from state fetched server-to-server from that service.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  userId                 String             @unique @db.Uuid
  planCode               PlanCode           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  interval               BillingInterval?
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEnd               DateTime?
  /// First time the subscription was seen PAST_DUE (start of the grace period).
  pastDueSince           DateTime?
  cancelledAt            DateTime?
  provider               String?
  /// The payment service's subscription id.
  providerSubscriptionId String?
  lastSyncedAt           DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@unique([provider, providerSubscriptionId])
  @@index([planCode, status])
  @@index([status, lastSyncedAt])
}

enum CheckoutStatus {
  PENDING
  /// Payment verified by the provider; waiting for its subscription record.
  VERIFYING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

/// One attempt to buy a paid plan (user-owned). The amount is computed by the
/// server from the plan; the plan is granted only from the provider's
/// verified state, never from this row or the browser.
model CheckoutSession {
  id                    String          @id @default(uuid(7)) @db.Uuid
  userId                String          @db.Uuid
  planCode              PlanCode
  interval              BillingInterval
  amountPaise           BigInt
  currency              String          @default("INR")
  provider              String
  status                CheckoutStatus  @default(PENDING)
  providerTransactionId String?
  providerAttemptId     String?
  /// Razorpay public key id for Checkout (not a secret).
  providerKeyId         String?
  /// Razorpay subscription id (what Checkout opens), or the sandbox order id.
  providerOrderId       String?
  failureReason         String?
  expiresAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)

  @@unique([id, userId])
  @@unique([provider, providerOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
}

enum UsageMetric {
  SEARCH
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  ALERT_CREATED
  EXPORT
}

/// Append-only metering, aggregated per period to enforce plan limits.
model UsageRecord {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @db.Uuid
  metric     UsageMetric
  quantity   Int         @default(1)
  occurredAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, metric, occurredAt])
}

/// Atomic per-period usage counters (one row per user, metric and window).
/// Consumption is a single conditional upsert, so concurrent requests can't
/// exceed the limit. Windows are IST calendar days / months.
model UsageCounter {
  userId      String      @db.Uuid
  metric      UsageMetric
  periodStart DateTime
  quantity    Int         @default(0)
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, metric, periodStart])
}

enum AffiliateRedirectStatus {
  /// Sent to the marketplace (with or without an affiliate tag).
  REDIRECTED
  /// Not sent: the stored destination failed validation (domain, scheme).
  BLOCKED
}

model AffiliateClick {
  id                String                  @id @default(uuid(7)) @db.Uuid
  /// Opaque reference appended to the affiliate link for attribution
  /// (e.g. Flipkart affExtParam1), so partner reports can be matched to clicks.
  clickRef          String                  @unique
  /// Null for anonymous visitors; set to NULL when a user is deleted so revenue
  /// reporting survives account deletion.
  userId            String?                 @db.Uuid
  offerId           String                  @db.Uuid
  sourceId          String                  @db.Uuid
  productId         String?                 @db.Uuid
  variantId         String?                 @db.Uuid
  /// Affiliate provider used ("amazon-associates", "flipkart-affiliate", "direct" = no affiliate tag).
  provider          String                  @default("direct")
  /// The (non-secret) tracking id attached to the link, if any.
  trackingId        String?
  destinationDomain String                  @default("")
  redirectStatus    AffiliateRedirectStatus @default(REDIRECTED)
  /// Where on DealMind the click came from (product, search, compare, watchlist).
  surface           String?
  /// Referrer host only (never the full URL).
  referrerDomain    String?
  /// Salted hash only; raw IP addresses are never stored. Cleared after the retention window.
  ipHash            String?
  /// Coarse device class only ("mobile" / "desktop"); cleared after the retention window.
  userAgent         String?
  createdAt         DateTime                @default(now())

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  offer       ProductOffer          @relation(fields: [offerId], references: [id], onDelete: Restrict)
  source      ShoppingSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  conversions AffiliateConversion[]

  @@index([userId])
  @@index([sourceId, createdAt])
  @@index([offerId])
  @@index([createdAt])
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
  /// Approved earlier, then cancelled or returned (commission clawed back).
  REVERSED
}

/// Global affiliate revenue reporting, imported from affiliate networks.
model AffiliateConversion {
  id               String           @id @default(uuid(7)) @db.Uuid
  clickId          String?          @db.Uuid
  sourceId         String           @db.Uuid
  /// Provider that reported it (the authoritative commission source).
  provider         String           @default("")
  /// The provider's order (item) id.
  externalOrderRef String
  orderAmountPaise BigInt
  commissionPaise  BigInt
  currency         String           @default("INR")
  status           ConversionStatus @default(PENDING)
  /// The provider's own status text, verbatim.
  providerStatus   String?
  orderedAt        DateTime?
  reportedAt       DateTime
  payoutId         String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  click  AffiliateClick?  @relation(fields: [clickId], references: [id], onDelete: SetNull)
  source ShoppingSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  payout AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalOrderRef])
  @@index([clickId])
  @@index([status, reportedAt])
}

enum AffiliatePayoutStatus {
  PENDING
  PAID
  FAILED
}

/// Payouts as reported by the partner (never computed by DealMind).
model AffiliatePayout {
  id              String                @id @default(uuid(7)) @db.Uuid
  provider        String
  sourceId        String?               @db.Uuid
  amountPaise     BigInt
  currency        String                @default("INR")
  status          AffiliatePayoutStatus @default(PENDING)
  payoutReference String
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  source      ShoppingSource?       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  conversions AffiliateConversion[]

  @@unique([provider, payoutReference])
}

enum BillingEventType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_CANCELED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_ISSUED
  /// A provider webhook (verified signature) before it is classified.
  WEBHOOK_RECEIVED
}

enum BillingEventProcessing {
  RECEIVED
  PROCESSED
  /// Verified but not applicable (e.g. unknown customer).
  IGNORED
  FAILED
}

/// Immutable ledger of billing events from the payment provider.
/// Restrict on user delete: financial records must be retained, so users with
/// billing history are anonymised/suspended rather than hard-deleted.
model BillingEvent {
  id               String                 @id @default(uuid(7)) @db.Uuid
  /// Null for a verified event whose customer isn't a DealMind user.
  userId           String?                @db.Uuid
  subscriptionId   String?                @db.Uuid
  type             BillingEventType
  provider         String
  /// Provider's event id: makes webhook processing idempotent.
  providerEventId  String
  /// The provider's own event type (e.g. "subscription.updated").
  eventType        String                 @default("")
  processingStatus BillingEventProcessing @default(RECEIVED)
  processedAt      DateTime?
  error            String?
  attempts         Int                    @default(0)
  amountPaise      BigInt?
  planCode         PlanCode?
  payload          Json                   @default("{}")
  occurredAt       DateTime
  createdAt        DateTime               @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([subscriptionId])
}

// ═══════════════════════════════ PLATFORM (global) ═══════════════════════════════

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// A browser's Web Push subscription (user-owned). Expired when the push
/// service answers 404/410; revoked when the user unsubscribes.
model PushSubscription {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  userAgent      String?
  failureCount   Int       @default(0)
  lastSuccessAt  DateTime?
  revokedAt      DateTime?
  expiredAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
