# Copy to .env and fill in. Never commit .env.

# ── Database / cache ──────────────────────────────────────────────
POSTGRES_USER=dealmind
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dealmind
# Used by the API and Prisma CLI when running outside Docker:
DATABASE_URL=postgresql://dealmind:change-me-local-only@localhost:5432/dealmind?schema=public
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost
API_DOCS_ENABLED=true

# ── Web ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
