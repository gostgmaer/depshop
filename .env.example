# DealMind AI — environment template.
# Copy to `.env` (git-ignored) and replace every `change_me`.
# These values are for LOCAL DEVELOPMENT ONLY. Real deployments must use
# unique, strong credentials supplied by a secret manager.
#
# Keep passwords URL-safe (letters, digits, - _ .) because they are embedded
# in DATABASE_URL / REDIS_URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=dealmind
POSTGRES_USER=dealmind
POSTGRES_PASSWORD=change_me
# Host port (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# ── Redis (BullMQ queues + caching) ───────────────────────────────
REDIS_PASSWORD=change_me
# Host port (bound to 127.0.0.1 only)
REDIS_PORT=6379

# ── Dev-only admin UIs (`docker compose --profile tools up -d`) ────
# pgAdmin rejects reserved domains such as .local; use a normal-looking email.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050
REDISINSIGHT_PORT=5540
# Set to true ONLY if you accept the RedisInsight EULA (https://redis.io/legal/redis-insight-license-terms/).
# When true, the DealMind Redis connection is pre-registered automatically.
REDISINSIGHT_ACCEPT_EULA=false

# ── Application connection strings (apps running on the HOST) ─────
# Containers on the Docker network get service-name URLs from docker-compose.yml
# (postgres:5432, redis:6379) and ignore these two values.
# Use 127.0.0.1, not "localhost": ports are bound to IPv4 loopback only, and
# some clients (incl. the Prisma engine on Windows) try IPv6 ::1 first.
DATABASE_URL=postgresql://dealmind:change_me@127.0.0.1:5432/dealmind?schema=public
REDIS_URL=redis://:change_me@127.0.0.1:6379

# ── API ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Required, min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost
API_DOCS_ENABLED=true

# ── Web ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Containerised app profile (Traefik) ───────────────────────────
HTTP_PORT=80
