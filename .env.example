# DealMind AI — environment template.
# Copy to `.env` (git-ignored) and replace every `change_me`.
# These values are for LOCAL DEVELOPMENT ONLY. Real deployments must use
# unique, strong credentials supplied by a secret manager.
#
# Keep passwords URL-safe (letters, digits, - _ .) because they are embedded
# in DATABASE_URL / REDIS_URL. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=dealmind
POSTGRES_USER=dealmind
POSTGRES_PASSWORD=change_me
# Host port (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# ── Redis (BullMQ queues + caching) ───────────────────────────────
REDIS_PASSWORD=change_me
# Host port (bound to 127.0.0.1 only)
REDIS_PORT=6379

# ── Dev-only admin UIs (`docker compose --profile tools up -d`) ────
# pgAdmin rejects reserved domains such as .local; use a normal-looking email.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050
REDISINSIGHT_PORT=5540
# Set to true ONLY if you accept the RedisInsight EULA (https://redis.io/legal/redis-insight-license-terms/).
# When true, the DealMind Redis connection is pre-registered automatically.
REDISINSIGHT_ACCEPT_EULA=false

# ── Application connection strings (apps running on the HOST) ─────
# Containers on the Docker network get service-name URLs from docker-compose.yml
# (postgres:5432, redis:6379) and ignore these two values.
# Use 127.0.0.1, not "localhost": ports are bound to IPv4 loopback only, and
# some clients (incl. the Prisma engine on Windows) try IPv6 ::1 first.
DATABASE_URL=postgresql://dealmind:change_me@127.0.0.1:5432/dealmind?schema=public
REDIS_URL=redis://:change_me@127.0.0.1:6379

# ── API ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Proxies trusted for client IPs ("loopback", "true", or CIDRs). The web app
# proxies /api from localhost in development.
TRUST_PROXY=loopback
# Public origin of the web app: used for the CSRF Origin allow-list and sent to
# the IAM as `appUrl`, so verification/reset emails link here. It MUST match the
# frontendUrl of the "dealmind" application registered in the IAM (see
# docs/SHARED_SERVICES.md); otherwise sign-up and reset fail with a 500.
APP_URL=http://localhost:3000
# Extra origins allowed to call the API with cookies (comma-separated; usually empty).
CORS_ORIGINS=
API_DOCS_ENABLED=true

# ── Sessions & cookies ────────────────────────────────────────────
# Required, min 32 chars: HMAC key for CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=7
# Secure cookies (+ __Host- prefix). Defaults to true when NODE_ENV=production;
# must be true whenever the site is served over HTTPS.
# COOKIE_SECURE=false

# ── Shared EasyDev IAM (identity provider) ────────────────────────
# DealMind does not store passwords or send identity email: the shared IAM
# (multi-tannet-auth-services) owns sign-up, verification, password reset and
# sessions. DealMind keeps its own HttpOnly cookie session in front of it.
IAM_BASE_URL=http://127.0.0.1:3304/api/v1/iam
# x-tenant-id sent to the IAM: a config constant only (DealMind has no tenancy).
# Self-registered IAM users always join the IAM's default tenant ("easydev").
IAM_TENANT=easydev
IAM_JWT_ISSUER=iam-service
IAM_JWT_AUDIENCE=easydev
IAM_TIMEOUT_MS=8000
# AES-256-GCM key (32 bytes, base64) encrypting the IAM tokens kept in DealMind
# sessions. Rotating it signs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Shared EasyDev notification service (optional until a feature uses it) ──
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4004
# The service's shared API key (its API_KEY setting).
NOTIFICATION_API_KEY=
NOTIFICATION_TENANT_ID=dealmind

# ── Shared EasyDev file-upload service (optional until a feature uses it) ──
FILE_SERVICE_URL=http://127.0.0.1:4005
# HMAC secret for signed identity headers (the service's GATEWAY_INTERNAL_SECRET).
FILE_SERVICE_HMAC_SECRET=
FILE_SERVICE_TENANT_ID=dealmind

# ── Web ───────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/* (and makes server-side session checks).
API_INTERNAL_URL=http://127.0.0.1:4000
# Reverse proxies in front of Next.js that set X-Forwarded-For. 0 = none (local
# dev): client IP headers are then ignored. Production behind Traefik: 1.
TRUSTED_PROXY_COUNT=0

# ── Containerised app profile (Traefik) ───────────────────────────
HTTP_PORT=80
