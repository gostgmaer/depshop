# DealMind AI — production / staging environment (TEMPLATE: placeholders only).
#
# Copy to /opt/dealmind/.env.production on the server (chmod 600, owned by the
# deploy user). NEVER commit the real file or bake it into an image.
# Staging uses its OWN copy with different values for every secret, its own
# domains, its own database volume, and payment-provider TEST mode.
#
# Generate secrets with:  openssl rand -hex 32
# (hex keeps them URL-safe for the connection strings built from them).
# scripts/deploy/check-env.sh validates this file before every deployment.

# ── Deployment ────────────────────────────────────────────────────────────
DEPLOY_ENV=production                 # staging | production (labels logs/metrics)
APP_DOMAIN=app.example.invalid        # https://APP_DOMAIN  → web (+ /api same origin)
# SEO_INDEXING: set to "enabled" only on the production host at launch (staging: never).
SEO_INDEXING=disabled
API_DOMAIN=api.example.invalid        # https://API_DOMAIN  → API (/api, /health/live, payment webhook)
ACME_EMAIL=ops@example.invalid        # Let's Encrypt account e-mail
# Staging: use the LE staging CA first to avoid rate limits, then remove.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
IMAGE_REGISTRY=ghcr.io/OWNER          # where CI pushes dealmind-{api,worker,web,agent,migrate}
# IMAGE_TAG: set by scripts/deploy/deploy.sh (commit SHA or release tag)
IMAGE_TAG=
EDGE_SUBNET=172.30.10.0/24            # Traefik network; the API trusts X-Forwarded-For only from here
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=dealmind
POSTGRES_USER=dealmind_owner          # owner: migrations ONLY (never used by running services)
POSTGRES_PASSWORD=
# DEALMIND_APP_DB_PASSWORD: api + worker (DML only; roles.sql)
DEALMIND_APP_DB_PASSWORD=
# DEALMIND_AGENT_DB_PASSWORD: agent (2 read models + checkpoint schema)
DEALMIND_AGENT_DB_PASSWORD=
DB_POOL_SIZE=10                       # Prisma connections per api/worker container
PG_SHARED_BUFFERS=512MB
PG_MAX_CONNECTIONS=100

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_KEY_PREFIX=dm

# ── Sessions and encryption ───────────────────────────────────────────────
# SESSION_SECRET: ≥ 32 chars; rotating it invalidates CSRF tokens
SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY: 32 bytes base64 (openssl rand -base64 32); rotating signs everyone out
TOKEN_ENCRYPTION_KEY=

# ── Internal service authentication ──────────────────────────────────────
# INTERNAL_API_TOKEN: agent → API /internal/v1
INTERNAL_API_TOKEN=
# AGENT_SERVICE_TOKEN: API/worker → agent
AGENT_SERVICE_TOKEN=
# AGENT_USER_CONTEXT_SECRET: HMAC for per-search signed user context
AGENT_USER_CONTEXT_SECRET=
# METRICS_TOKEN: Prometheus → API /metrics (private network only)
METRICS_TOKEN=

# ── Shared EasyDev identity (IAM) ─────────────────────────────────────────
IAM_BASE_URL=https://iam.example.invalid/api/v1/iam
IAM_TENANT=easydev
IAM_JWT_ISSUER=iam-service
IAM_JWT_AUDIENCE=easydev

# ── LLM provider (agent) ──────────────────────────────────────────────────
LLM_PROVIDER=google                   # google | openai | rules (rules = no LLM calls)
# LLM_MODEL: the provider's model name
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Marketplace connectors (leave EMPTY until the program is approved) ────
# An unconfigured connector reports PENDING_CREDENTIALS and is never shown as searched.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_ASSOCIATES_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ── Payments (shared EasyDev payment service; Razorpay keys live THERE) ───
BILLING_PROVIDER=none                 # none | easydev-payments  (staging: easydev-payments in TEST mode)
PAYMENT_SERVICE_URL=
PAYMENT_SERVICE_API_KEY=
PAYMENT_TENANT_ID=easydev
PAYMENT_APPLICATION_ID=dealmind
# PAYMENT_WEBHOOK_SECRET: Shared secret for the payment service webhook (empty until issued).
PAYMENT_WEBHOOK_SECRET=
# Days of paid access kept after a failed renewal.
BILLING_GRACE_DAYS=3
# Free during launch: every account gets this plan (FREE | PRO | BUSINESS) at no cost and
# checkout is refused. Leave empty for normal paid plans. Plan limits are editable in Admin.
LAUNCH_FREE_PLAN=PRO

# ── E-mail (shared EasyDev notification service; SMTP is configured THERE) ─
NOTIFICATION_SERVICE_URL=
NOTIFICATION_API_KEY=
NOTIFICATION_TENANT_ID=dealmind
# NOTIFICATION_TOKEN_SECRET: signs one-click unsubscribe links
NOTIFICATION_TOKEN_SECRET=

# ── Web push (optional; generate once with `pnpm notifications:vapid`) ────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.invalid

# ── File uploads (optional) ───────────────────────────────────────────────
FILE_SERVICE_URL=
FILE_SERVICE_HMAC_SECRET=
FILE_SERVICE_TENANT_ID=dealmind

# ── Privacy notice (REQUIRED before launch) ───────────────────────────────
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# ── Backups (scripts/backup/pg-backup.sh) ─────────────────────────────────
BACKUP_DIR=/var/backups/dealmind
BACKUP_RETENTION_DAYS=14
# age public key (age1...) to encrypt dumps at rest; strongly recommended.
BACKUP_AGE_RECIPIENT=
# Optional off-host copy, e.g. "rclone copy {file} remote:dealmind-backups"
# ({file} is replaced with the dump path). Leave empty to keep backups local.
BACKUP_UPLOAD_CMD=

# ── Monitoring (optional profile; docs/monitoring-and-alerting.md) ────────
# ALERTMANAGER_WEBHOOK_URL: where alerts are sent (chat/pager webhook)
ALERTMANAGER_WEBHOOK_URL=

# ── Smoke tests (dedicated TEST account, never a real user) ───────────────
SMOKE_EMAIL=
SMOKE_PASSWORD=

# ── Optional tuning (all have working defaults in the compose file) ───────
# WORKER_CONCURRENCY=4  NOTIFICATION_CONCURRENCY=5  PRICE_TRACKING_CONCURRENCY=8
# TRACKING_ENABLED=true  TRACKING_SOURCE_SHARE=0.5  TRACKING_MAX_QUEUED=2000
# AGENT_TIMEOUT_SECONDS=180  AGENT_MAX_CONNECTIONS=64  LLM_TEMPERATURE=0.2  LLM_MAX_TOKENS=8192
# CORS_ORIGINS=   (extra cookie-authenticated origins; normally empty)
# PG_SLOW_QUERY_MS=500  TRAEFIK_LOG_LEVEL=INFO  WORKER_STOP_GRACE=120s

# ── Resource limits (optional overrides) ──────────────────────────────────
# API_CPUS=1.5  API_MEMORY=1G  WORKER_CPUS=1.5  WORKER_MEMORY=1G
# AGENT_CPUS=1.0 AGENT_MEMORY=1G WEB_CPUS=1.0 WEB_MEMORY=768M PG_CPUS=2.0 PG_MEMORY=2G

# ── Backup freshness metrics for node-exporter (monitoring overlay) ──
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile
