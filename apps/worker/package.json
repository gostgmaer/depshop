{
  "name": "@dealmind/worker",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "dotenv -e ../../.env -- vitest run -c vitest.db.config.ts",
    "test:load": "dotenv -e ../../.env -- vitest run -c vitest.load.config.ts"
  },
  "dependencies": {
    "@dealmind/affiliate": "workspace:*",
    "@dealmind/billing": "workspace:*",
    "@dealmind/catalog": "workspace:*",
    "@dealmind/connectors": "workspace:*",
    "@dealmind/db": "workspace:*",
    "@dealmind/notifications": "workspace:*",
    "@dealmind/queue": "workspace:*",
    "@dealmind/shared": "workspace:*",
    "@easydev_org/notification-sdk": "1.0.3",
    "@opentelemetry/api": "^1.9.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2"
  }
}
