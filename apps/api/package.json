{
  "name": "@dealmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "dotenv -e ../../.env -- vitest run -c vitest.db.config.ts",
    "test:contract": "dotenv -e ../../.env -- vitest run -c vitest.contract.config.ts"
  },
  "dependencies": {
    "@dealmind/catalog": "workspace:*",
    "@dealmind/db": "workspace:*",
    "@dealmind/queue": "workspace:*",
    "@dealmind/shared": "workspace:*",
    "@easydev_org/file-upload-sdk": "1.0.4",
    "@easydev_org/notification-sdk": "1.0.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
